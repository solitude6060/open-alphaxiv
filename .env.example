OPEN_ALPHAXIV_STORAGE_DIR=./data
OPEN_ALPHAXIV_DATABASE_PATH=./data/open_alphaxiv.db
WEB_PORT=3100
OPEN_ALPHAXIV_CORS_ORIGIN=http://localhost:3100

# Optional OpenAI-compatible provider. Healthcheck performs a real GET
# {base_url}/models. http is allowed only for localhost; other hosts require https.
# Link-local metadata addresses are rejected.
OPENAI_COMPATIBLE_BASE_URL=https://api.openai.com/v1
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_CHAT_MODEL=gpt-4.1
OPENAI_COMPATIBLE_EMBEDDING_MODEL=text-embedding-3-small

# Optional local Codex agent for paper Q&A. The backend process must be able to
# execute the Codex CLI and read Codex credentials. This is not browser OAuth.
OPEN_ALPHAXIV_CODEX_ENABLED=false
OPEN_ALPHAXIV_CODEX_CLI_PATH=codex
OPEN_ALPHAXIV_CODEX_MODEL=
OPEN_ALPHAXIV_CODEX_TIMEOUT_SECONDS=180
OPEN_ALPHAXIV_CODEX_SANDBOX=read-only
CODEX_HOME=
CODEX_ACCESS_TOKEN=
CODEX_API_KEY=
CODEX_AUTH_JSON_PATH=

# Optional Claude Code CLI paper Q&A. Spawns `claude -p` without --bare so the
# host Claude Code login can be used. Do not copy OAuth tokens into this app.
OPEN_ALPHAXIV_CLAUDE_ENABLED=false
OPEN_ALPHAXIV_CLAUDE_CLI_PATH=claude
OPEN_ALPHAXIV_CLAUDE_TIMEOUT_SECONDS=180

# Optional OpenCode CLI paper Q&A. Spawns `opencode run`. Do not enable Claude
# Pro/Max OAuth plugins.
OPEN_ALPHAXIV_OPENCODE_ENABLED=false
OPEN_ALPHAXIV_OPENCODE_CLI_PATH=opencode
OPEN_ALPHAXIV_OPENCODE_MODEL=
OPEN_ALPHAXIV_OPENCODE_TIMEOUT_SECONDS=180

# Used only with docker-compose.codex.yml to mount a host Codex install.
OPEN_ALPHAXIV_HOST_NODE_PREFIX=
OPEN_ALPHAXIV_HOST_CODEX_HOME=

# Optional arXiv category feed. Metadata only until the user opens a paper.
OPEN_ALPHAXIV_ARXIV_CATEGORIES=cs.LG
OPEN_ALPHAXIV_FEED_MIN_INTERVAL_SECONDS=900

# Optional Semantic Scholar API key. Graph requests go only to api.semanticscholar.org.
# Unauthenticated requests often receive HTTP 429; a key is required for reliable builds.
SEMANTIC_SCHOLAR_API_KEY=
